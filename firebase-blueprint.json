        "monitorName": { "type": "string" },
        "monitorAssignedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "monitorAssignedAt", "updatedAt"]
    },
    "ChatPresence": {
      "title": "ChatPresence",
      "description": "Active member presence, raise-hand state, speaking status, and monitor voice-mute inside a public chat room.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "enum": ["lounge", "creators_hub", "photo_critique", "video_showcase", "vip_hangout"]
        },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "support", "admin", "owner"] },
        "isInvisible": { "type": "boolean" },
        "handRaised": { "type": "boolean" },
        "handRaisedAt": { "type": "integer" },
        "isVoiceMuted": { "type": "boolean" },
        "voiceMutedByUid": { "type": "string" },
        "isSpeaking": { "type": "boolean" },
        "joinedAtMillis": { "type": "integer" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "userId", "displayName", "role", "isInvisible", "joinedAt", "lastActiveAt"]
    },
    "ChatRoomVoiceChunk": {
      "title": "ChatRoomVoiceChunk",
