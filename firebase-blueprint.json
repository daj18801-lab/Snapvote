          "enum": ["open", "action_taken", "dismissed"]
        },
        "reviewedByUid": { "type": "string" },
        "resolutionNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "reportId",
        "reportedUserId",
        "reportedUserName",
        "reporterId",
        "reporterName",
        "reason",
        "details",
        "sourceContext",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
