{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile, role, chat pass expiries, and vote/token wallet balance.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user UID."
        },
        "email": {
          "type": "string",
          "description": "Verified lowercase Google account email."
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown on uploads, chat, friends, and profile."
        },
        "bio": {
          "type": "string",
          "description": "Optional short creator bio."
        },
        "age": {
          "type": "integer",
          "description": "Optional public age (18-110) for user discovery filtering."
        },
        "sex": {
          "type": "string",
          "enum": ["female", "male", "non_binary", "unspecified"],
          "description": "Optional sex/gender option for user discovery filtering."
        },
        "role": {
          "type": "string",
          "enum": ["user", "support", "admin"],
          "description": "Account privilege tier assigned by owner/admin."
        },
        "voteBalance": {
          "type": "integer",
          "description": "Total available tokens (free starter/bonus tokens plus paid tokens)."
        },
        "paidVoteBalance": {
          "type": "integer",
          "description": "Purchased tokens only (starts at 0 on signup). Required for creator gallery unlocks (40% creator payout) and live call payouts (70%)."
        },
        "totalVotesCast": {
          "type": "integer",
          "description": "Lifetime votes cast by this user."
        },
        "totalVotesPurchased": {
          "type": "integer",
          "description": "Lifetime votes/tokens acquired through paid packs."
        },
        "chatAccessExpiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiration timestamp for paid 5-day public chat room access passes."
        },
        "privateChatAccessExpiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiration timestamp for 7-day (1 week) private messaging and private group chat pass (5 tokens/week)."
        },
        "phoneTokenBalance": {
          "type": "integer",
          "description": "Available purchased phone tokens used for scheduling mic-to-mic conversations (5 tokens/minute)."
        },
        "totalPhoneTokensPurchased": {
          "type": "integer",
          "description": "Lifetime phone tokens purchased by this user."
        },
        "lastRefundedSessionId": {
          "type": "string",
          "description": "Session ID of the most recent declined/cancelled mic session refund claimed into phoneTokenBalance."
        },
        "supportStartedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user began active Support staff role (starts 6-month / 180-day eligibility timer for weekly token payroll)."
        },
        "lastSupportPayClaimAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the most recent 100-token weekly Support payroll claim."
        },
        "totalSupportPayTokensEarned": {
          "type": "integer",
          "description": "Lifetime 100-token weekly Support payroll tokens earned after 6 months of Support service."
        },
        "referralCode": {
          "type": "string",
          "description": "Unique uppercase alphanumeric referral code shared with friends."
        },
        "referralCashableBalance": {
          "type": "integer",
          "description": "Earned referral reward tokens that can be spent on content creators or cashed in ($0.10/token)."
        },
        "totalReferralTokensEarned": {
          "type": "integer",
          "description": "Lifetime referral milestone reward tokens earned."
        },
        "totalReferralTokensCashedIn": {
          "type": "integer",
          "description": "Lifetime referral reward tokens cashed in for cash payouts."
        },
        "lastReferralClaimId": {
          "type": "string",
          "description": "Claim ID of the most recent 10-referral 100-token milestone reward claimed."
        },
        "lastReferralCashoutId": {
          "type": "string",
          "description": "Cashout ID of the most recent referral token cash-in request."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created (starts 7-day free public chat trial)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": [
        "userId",
        "displayName",
        "voteBalance",
        "totalVotesCast",
        "totalVotesPurchased",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreatorUnlock": {
      "title": "CreatorUnlock",
      "description": "Receipt recording that a viewer spent votes to unlock all media from a specific creator.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "creatorId": { "type": "string" },
        "votesSpent": { "type": "integer" },
        "unlockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "creatorId", "votesSpent", "unlockedAt"]
    },
    "VotePurchase": {
      "title": "VotePurchase",
      "description": "Ledger record for a vote/token pack purchase.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "packId": { "type": "string" },
        "packTitle": { "type": "string" },
        "votesAdded": { "type": "integer" },
        "priceLabel": { "type": "string" },
        "purchasedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "packId", "packTitle", "votesAdded", "priceLabel", "purchasedAt"]
    },
    "CreatorSummary": {
      "title": "CreatorSummary",
      "description": "Public creator showcase & online presence metadata without PII.",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "age": { "type": "integer" },
        "sex": {
          "type": "string",
          "enum": ["female", "male", "non_binary", "unspecified"]
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "hidden"]
        },
        "postCount": { "type": "integer" },
        "totalVotesReceived": { "type": "integer" },
        "freePreviewLimit": { "type": "integer" },
        "unlockCostVotes": { "type": "integer" },
        "isOnline": {
          "type": "boolean",
          "description": "Real-time online indicator shown in Friends list and discovery."
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest heartbeat or disconnect."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "creatorId",
        "displayName",
        "visibility",
        "postCount",
        "totalVotesReceived",
        "freePreviewLimit",
        "unlockCostVotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "MediaPost": {
      "title": "MediaPost",
      "description": "A user-uploaded photo or video post with community vote count.",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["photo", "video"] },
        "caption": { "type": "string" },
        "mediaBase64": { "type": "string" },
        "mediaDownloadUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "localVideoFileName": { "type": "string" },
        "durationMs": { "type": "integer" },
        "postIndex": { "type": "integer" },
        "voteCount": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["public", "hidden"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "creatorId",
        "creatorName",
        "mediaType",
        "caption",
        "mediaBase64",
        "durationMs",
        "postIndex",
        "voteCount",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "PostVoteRecord": {
      "title": "PostVoteRecord",
      "description": "Per-user vote tally for a specific post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "voterId": { "type": "string" },
        "votesCast": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "voterId", "votesCast", "createdAt", "updatedAt"]
    },
    "StaffRole": {
      "title": "StaffRole",
      "description": "Trusted staff role assignment keyed by lowercase Google email.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayLabel": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "support"] },
        "active": { "type": "boolean" },
        "assignedByUid": { "type": "string" },
        "assignedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "active", "assignedByUid", "assignedByEmail", "createdAt", "updatedAt"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "description": "User-submitted moderation report for a post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "postCreatorId": { "type": "string" },
        "postCaption": { "type": "string" },
        "reporterId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
        "reviewedByUid": { "type": "string" },
        "resolutionNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "postCreatorId", "postCaption", "reporterId", "reason", "status", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
