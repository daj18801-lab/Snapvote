        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "banned", "moderatedByUid", "updatedAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "User-submitted report against another user for harassment, spam, impersonation, or safety violations.",
