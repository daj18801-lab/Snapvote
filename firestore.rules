rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything unless explicitly matched and allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStaffEmailId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidRoomId(roomId) {
      return roomId in ['lounge', 'creators_hub', 'photo_critique', 'video_showcase', 'vip_hangout'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true &&
             ('email' in request.auth.token) &&
             request.auth.token.email is string;
    }

    function isBootstrappedOwner() {
      return hasVerifiedEmail() &&
             request.auth.token.email.lower() == 'daj18801@gmail.com';
    }

    function hasStaffDocRole(roles) {
      return hasVerifiedEmail() &&
             exists(/databases/$(database)/documents/staff_roles/$(request.auth.token.email.lower())) &&
             get(/databases/$(database)/documents/staff_roles/$(request.auth.token.email.lower())).data.active == true &&
             get(/databases/$(database)/documents/staff_roles/$(request.auth.token.email.lower())).data.role in roles;
    }

    function hasUserDocRole(roles) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function isAdmin() {
      return isBootstrappedOwner() || hasStaffDocRole(['admin']) || hasUserDocRole(['admin']);
    }

    function isSupportOrAdmin() {
      return isBootstrappedOwner() || hasStaffDocRole(['admin', 'support']) || hasUserDocRole(['admin', 'support']);
    }

    function isStaffAllowedSenderRole(senderRole) {
      return (senderRole == 'owner' && isBootstrappedOwner()) ||
             (senderRole == 'admin' && isAdmin()) ||
             (senderRole == 'support' && isSupportOrAdmin()) ||
             (senderRole == 'user' && isSupportOrAdmin());
    }

    function isTargetProtectedOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             ('email' in get(/databases/$(database)/documents/users/$(userId)).data) &&
             get(/databases/$(database)/documents/users/$(userId)).data.email == 'daj18801@gmail.com';
    }

    function isTargetAdmin(userId) {
      return isTargetProtectedOwner(userId) || (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        ('role' in get(/databases/$(database)/documents/users/$(userId)).data) &&
        get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin'
      );
    }

    function isTargetStaff(userId) {
      return isTargetProtectedOwner(userId) || (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        ('role' in get(/databases/$(database)/documents/users/$(userId)).data) &&
        get(/databases/$(database)/documents/users/$(userId)).data.role in ['admin', 'support']
      );
    }

    function isRoomMonitor(roomId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
             get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.monitorUid == request.auth.uid &&
             exists(/databases/$(database)/documents/chat_rooms/$(roomId)/presence/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/chat_rooms/$(roomId)/presence/$(request.auth.uid)).data.isInvisible == false;
    }

    function isChatBanned() {
      return exists(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data.banned == true;
    }

    function isChatMuted() {
      return exists(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)) &&
             ('mutedUntil' in get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data) &&
             get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data.mutedUntil is timestamp &&
             request.time < get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data.mutedUntil;
    }

    function isBouncedFromRoom(roomId) {
      return exists(/databases/$(database)/documents/chat_rooms/$(roomId)/bounces/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/chat_rooms/$(roomId)/bounces/$(request.auth.uid)).data.bouncedUntil is timestamp &&
             request.time < get(/databases/$(database)/documents/chat_rooms/$(roomId)/bounces/$(request.auth.uid)).data.bouncedUntil;
    }

    function hasPaidOrTrialChatAccess() {
      return isSignedIn();
    }

    function hasPrivateChatAccess() {
      return isSignedIn();
    }

    function isAccountRestricted() {
      return !isSupportOrAdmin() &&
             exists(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)) && (
               (('accountBanned' in get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data) &&
                get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data.accountBanned == true) ||
               (('suspendedUntil' in get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data) &&
                get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data.suspendedUntil is timestamp &&
                request.time < get(/databases/$(database)/documents/chat_moderation/$(request.auth.uid)).data.suspendedUntil)
             );
    }

    function canReadChatRoom(roomId) {
      return isSupportOrAdmin() ||
             (!isAccountRestricted() && !isChatBanned() && !isBouncedFromRoom(roomId) && hasPaidOrTrialChatAccess());
    }

    function isDirectChatParticipant(threadId) {
      return exists(/databases/$(database)/documents/direct_chats/$(threadId)) &&
             request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(threadId)).data.participantIds;
    }

    function isGroupChatMember(groupId) {
      return exists(/databases/$(database)/documents/group_chats/$(groupId)) &&
             request.auth.uid in get(/databases/$(database)/documents/group_chats/$(groupId)).data.memberIds;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 128)) &&
             data.displayName is string &&
             data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 240)) &&
             (!('age' in data) || data.age == null || (data.age is int && data.age >= 18 && data.age <= 110)) &&
             (!('sex' in data) || data.sex == null || data.sex in ['female', 'male', 'non_binary', 'unspecified']) &&
             (!('role' in data) || data.role in ['user', 'support', 'admin']) &&
             data.voteBalance is int &&
             data.voteBalance >= 0 && data.voteBalance <= 1000000 &&
             (!('paidVoteBalance' in data) || (data.paidVoteBalance is int && data.paidVoteBalance >= 0 && data.paidVoteBalance <= 1000000 && data.paidVoteBalance <= data.voteBalance)) &&
             data.totalVotesCast is int &&
             data.totalVotesCast >= 0 && data.totalVotesCast <= 1000000 &&
             data.totalVotesPurchased is int &&
             data.totalVotesPurchased >= 0 && data.totalVotesPurchased <= 1000000 &&
             (!('chatAccessExpiresAt' in data) || data.chatAccessExpiresAt == null || data.chatAccessExpiresAt is timestamp) &&
             (!('privateChatAccessExpiresAt' in data) || data.privateChatAccessExpiresAt == null || data.privateChatAccessExpiresAt is timestamp) &&
             (!('phoneTokenBalance' in data) || (data.phoneTokenBalance is int && data.phoneTokenBalance >= 0 && data.phoneTokenBalance <= 1000000)) &&
             (!('totalPhoneTokensPurchased' in data) || (data.totalPhoneTokensPurchased is int && data.totalPhoneTokensPurchased >= 0 && data.totalPhoneTokensPurchased <= 1000000)) &&
             (!('lastRefundedSessionId' in data) || data.lastRefundedSessionId == null || (data.lastRefundedSessionId is string && data.lastRefundedSessionId.size() <= 128)) &&
             (!('videoTokenBalance' in data) || (data.videoTokenBalance is int && data.videoTokenBalance >= 0 && data.videoTokenBalance <= 1000000)) &&
             (!('totalVideoTokensPurchased' in data) || (data.totalVideoTokensPurchased is int && data.totalVideoTokensPurchased >= 0 && data.totalVideoTokensPurchased <= 10000000)) &&
             (!('lastRefundedVideoSessionId' in data) || data.lastRefundedVideoSessionId == null || (data.lastRefundedVideoSessionId is string && data.lastRefundedVideoSessionId.size() <= 128)) &&
             (!('supportStartedAt' in data) || data.supportStartedAt == null || data.supportStartedAt is timestamp) &&
             (!('lastSupportPayClaimAt' in data) || data.lastSupportPayClaimAt == null || data.lastSupportPayClaimAt is timestamp) &&
             (!('totalSupportPayTokensEarned' in data) || (data.totalSupportPayTokensEarned is int && data.totalSupportPayTokensEarned >= 0 && data.totalSupportPayTokensEarned <= 10000000)) &&
             (!('referralCode' in data) || data.referralCode == null || isValidReferralCode(data.referralCode)) &&
             (!('referralCashableBalance' in data) || (data.referralCashableBalance is int && data.referralCashableBalance >= 0 && data.referralCashableBalance <= 1000000 && data.referralCashableBalance <= (('paidVoteBalance' in data && data.paidVoteBalance is int) ? data.paidVoteBalance : 0))) &&
             (!('totalReferralTokensEarned' in data) || (data.totalReferralTokensEarned is int && data.totalReferralTokensEarned >= 0 && data.totalReferralTokensEarned <= 10000000)) &&
             (!('totalReferralTokensCashedIn' in data) || (data.totalReferralTokensCashedIn is int && data.totalReferralTokensCashedIn >= 0 && data.totalReferralTokensCashedIn <= 10000000)) &&
             (!('lastReferralClaimId' in data) || data.lastReferralClaimId == null || (data.lastReferralClaimId is string && data.lastReferralClaimId.size() <= 128)) &&
             (!('lastReferralCashoutId' in data) || data.lastReferralCashoutId == null || (data.lastReferralCashoutId is string && data.lastReferralCashoutId.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidReferralCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]{6,16}$');
    }

    function existingPaidVoteBalance() {
      return existing().get('paidVoteBalance', 0);
    }

    function incomingPaidVoteBalance() {
      return incoming().get('paidVoteBalance', 0);
    }

    function existingReferralCashableBalance() {
      return existing().get('referralCashableBalance', 0);
    }

    function incomingReferralCashableBalance() {
      return incoming().get('referralCashableBalance', 0);
    }

    function isValidTokenSpendBalances(cost) {
      return incoming().voteBalance == existing().voteBalance - cost &&
             ((existing().voteBalance - existing().get('paidVoteBalance', 0) >= cost &&
               incoming().get('paidVoteBalance', 0) == existing().get('paidVoteBalance', 0)) ||
              (existing().voteBalance - existing().get('paidVoteBalance', 0) < cost &&
               incoming().get('paidVoteBalance', 0) == incoming().voteBalance)) &&
             incoming().get('referralCashableBalance', 0) ==
               (existing().get('referralCashableBalance', 0) <= incoming().get('paidVoteBalance', 0)
                 ? existing().get('referralCashableBalance', 0)
                 : incoming().get('paidVoteBalance', 0));
    }

    function existingTotalReferralTokensEarned() {
      return existing().get('totalReferralTokensEarned', 0);
    }

    function existingTotalReferralTokensCashedIn() {
      return existing().get('totalReferralTokensCashedIn', 0);
    }

    function existingPhoneBalance() {
      return existing().get('phoneTokenBalance', 0);
    }

    function existingTotalPhonePurchased() {
      return existing().get('totalPhoneTokensPurchased', 0);
    }

    function existingTotalSupportPayEarned() {
      return existing().get('totalSupportPayTokensEarned', 0);
    }

    function hasSixMonthSupportTenure() {
      return (
        (('role' in existing()) && existing().role == 'support' &&
         ('supportStartedAt' in existing()) && existing().supportStartedAt is timestamp &&
         request.time >= existing().supportStartedAt + duration.value(180, 'd')) ||
        (hasVerifiedEmail() &&
         exists(/databases/$(database)/documents/staff_roles/$(request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/staff_roles/$(request.auth.token.email.lower())).data.role == 'support' &&
         get(/databases/$(database)/documents/staff_roles/$(request.auth.token.email.lower())).data.active == true && (
           (('supportStartedAt' in existing()) && existing().supportStartedAt is timestamp &&
            request.time >= existing().supportStartedAt + duration.value(180, 'd')) ||
           (!('supportStartedAt' in existing()) &&
            request.time >= get(/databases/$(database)/documents/staff_roles/$(request.auth.token.email.lower())).data.createdAt + duration.value(180, 'd'))
         ))
      );
    }

    function hasSupportWeeklyCooldownElapsed() {
      return !('lastSupportPayClaimAt' in existing()) ||
             existing().lastSupportPayClaimAt == null ||
             request.time >= existing().lastSupportPayClaimAt + duration.value(7, 'd');
    }

    function isMicSessionParticipant(sessionId) {
      return exists(/databases/$(database)/documents/mic_sessions/$(sessionId)) &&
             request.auth.uid in get(/databases/$(database)/documents/mic_sessions/$(sessionId)).data.participantIds;
    }

    function isMicSessionCallable(sessionId) {
      return exists(/databases/$(database)/documents/mic_sessions/$(sessionId)) &&
             get(/databases/$(database)/documents/mic_sessions/$(sessionId)).data.status in ['accepted', 'active'];
    }

    function existingVideoBalance() {
      return existing().get('videoTokenBalance', 0);
    }

    function existingTotalVideoPurchased() {
      return existing().get('totalVideoTokensPurchased', 0);
    }

    function isVideoSessionParticipant(sessionId) {
      return exists(/databases/$(database)/documents/video_sessions/$(sessionId)) &&
             request.auth.uid in get(/databases/$(database)/documents/video_sessions/$(sessionId)).data.participantIds;
    }

    function isVideoSessionCallable(sessionId) {
      return exists(/databases/$(database)/documents/video_sessions/$(sessionId)) &&
             get(/databases/$(database)/documents/video_sessions/$(sessionId)).data.status in ['accepted', 'active'];
    }

    function isSelfUserTokenActionAllowed(data, prev, changed) {
      return (
        // Action: Claim 10-referral milestone (+100 tokens usable on content creators OR cashable)
        (changed.hasOnly(['voteBalance', 'paidVoteBalance', 'referralCashableBalance', 'totalReferralTokensEarned', 'lastReferralClaimId', 'updatedAt']) &&
         data.voteBalance == prev.voteBalance + 100 &&
         data.voteBalance <= 1000000 &&
         data.paidVoteBalance == prev.get('paidVoteBalance', 0) + 100 &&
         data.referralCashableBalance == prev.get('referralCashableBalance', 0) + 100 &&
         data.totalReferralTokensEarned == prev.get('totalReferralTokensEarned', 0) + 100 &&
         data.totalVotesCast == prev.totalVotesCast &&
         data.totalVotesPurchased == prev.totalVotesPurchased &&
         isValidId(data.lastReferralClaimId) &&
         !exists(/databases/$(database)/documents/referral_claims/$(data.lastReferralClaimId)) &&
         getAfter(/databases/$(database)/documents/referral_claims/$(data.lastReferralClaimId)).data.referrerId == request.auth.uid) ||
        // Action: Cash in earned referral tokens ($0.10/token) atomically with /referral_cashouts/{cashoutId}
        (changed.hasOnly(['voteBalance', 'paidVoteBalance', 'referralCashableBalance', 'totalReferralTokensCashedIn', 'lastReferralCashoutId', 'updatedAt']) &&
         data.lastReferralCashoutId is string &&
         isValidId(data.lastReferralCashoutId) &&
         data.referralCashableBalance is int &&
         data.referralCashableBalance >= 0 &&
         data.referralCashableBalance < prev.get('referralCashableBalance', 0) &&
         data.paidVoteBalance is int &&
         data.paidVoteBalance >= 0 &&
         data.paidVoteBalance == prev.get('paidVoteBalance', 0) - (prev.get('referralCashableBalance', 0) - data.referralCashableBalance) &&
         data.voteBalance >= 0 &&
         data.voteBalance == prev.voteBalance - (prev.get('referralCashableBalance', 0) - data.referralCashableBalance) &&
         data.totalReferralTokensCashedIn == prev.get('totalReferralTokensCashedIn', 0) + (prev.get('referralCashableBalance', 0) - data.referralCashableBalance) &&
         data.totalVotesCast == prev.totalVotesCast &&
         data.totalVotesPurchased == prev.totalVotesPurchased &&
         !exists(/databases/$(database)/documents/referral_cashouts/$(data.lastReferralCashoutId)) &&
         getAfter(/databases/$(database)/documents/referral_cashouts/$(data.lastReferralCashoutId)).data.userId == request.auth.uid &&
         getAfter(/databases/$(database)/documents/referral_cashouts/$(data.lastReferralCashoutId)).data.tokensCashedIn == (prev.get('referralCashableBalance', 0) - data.referralCashableBalance)) ||
        // Action: Spend PAID tokens (purchased or referral-earned) to unlock a creator gallery
        (changed.hasOnly(['voteBalance', 'paidVoteBalance', 'referralCashableBalance', 'updatedAt']) &&
         data.voteBalance is int &&
         data.voteBalance >= 0 &&
         data.voteBalance < prev.voteBalance &&
         (prev.voteBalance - data.voteBalance) <= 25 &&
         data.paidVoteBalance is int &&
         data.paidVoteBalance >= 0 &&
         data.paidVoteBalance <= data.voteBalance &&
         data.paidVoteBalance < prev.get('paidVoteBalance', 0) &&
         (prev.get('paidVoteBalance', 0) - data.paidVoteBalance) == (prev.voteBalance - data.voteBalance) &&
         data.totalVotesCast == prev.totalVotesCast &&
         data.totalVotesPurchased == prev.totalVotesPurchased &&
         data.get('referralCashableBalance', 0) >= 0 &&
         data.get('referralCashableBalance', 0) ==
           (prev.get('referralCashableBalance', 0) <= data.paidVoteBalance
             ? prev.get('referralCashableBalance', 0)
             : data.paidVoteBalance)) ||
        // Action: Purchase votes/tokens (credits both total voteBalance and paidVoteBalance)
        (changed.hasOnly(['voteBalance', 'paidVoteBalance', 'totalVotesPurchased', 'updatedAt']) &&
         data.voteBalance is int &&
         data.voteBalance > prev.voteBalance &&
         data.voteBalance <= 1000000 &&
         (data.voteBalance - prev.voteBalance) <= 1000 &&
         data.paidVoteBalance is int &&
         data.paidVoteBalance == prev.get('paidVoteBalance', 0) + (data.voteBalance - prev.voteBalance) &&
         (data.totalVotesPurchased - prev.totalVotesPurchased) == (data.voteBalance - prev.voteBalance) &&
         data.totalVotesPurchased <= 1000000 &&
         data.totalVotesCast == prev.totalVotesCast) ||
        // Action: Spend 1 vote to vote on a post
        (changed.hasOnly(['voteBalance', 'paidVoteBalance', 'referralCashableBalance', 'totalVotesCast', 'updatedAt']) &&
         prev.voteBalance >= 1 &&
         data.totalVotesCast == prev.totalVotesCast + 1 &&
         data.totalVotesPurchased == prev.totalVotesPurchased &&
         isValidTokenSpendBalances(1)) ||
        // Action: Spend 5 vote coins for 5 days of public chat room access
        (changed.hasOnly(['voteBalance', 'paidVoteBalance', 'referralCashableBalance', 'chatAccessExpiresAt', 'updatedAt']) &&
         prev.voteBalance >= 5 &&
         isValidTokenSpendBalances(5) &&
         data.totalVotesCast == prev.totalVotesCast &&
         data.totalVotesPurchased == prev.totalVotesPurchased &&
         data.chatAccessExpiresAt is timestamp &&
         data.chatAccessExpiresAt > request.time &&
         ((!('chatAccessExpiresAt' in prev) || prev.chatAccessExpiresAt == null || prev.chatAccessExpiresAt <= request.time)
           ? data.chatAccessExpiresAt <= request.time + duration.value(5, 'd') + duration.value(5, 'm')
           : data.chatAccessExpiresAt <= prev.chatAccessExpiresAt + duration.value(5, 'd') + duration.value(5, 'm'))) ||
        // Action: Spend 5 tokens for 7 days of private messages & private group chats
        (changed.hasOnly(['voteBalance', 'paidVoteBalance', 'referralCashableBalance', 'privateChatAccessExpiresAt', 'updatedAt']) &&
         prev.voteBalance >= 5 &&
         isValidTokenSpendBalances(5) &&
         data.totalVotesCast == prev.totalVotesCast &&
         data.totalVotesPurchased == prev.totalVotesPurchased &&
         data.privateChatAccessExpiresAt is timestamp &&
         data.privateChatAccessExpiresAt > request.time &&
         ((!('privateChatAccessExpiresAt' in prev) || prev.privateChatAccessExpiresAt == null || prev.privateChatAccessExpiresAt <= request.time)
           ? data.privateChatAccessExpiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm')
           : data.privateChatAccessExpiresAt <= prev.privateChatAccessExpiresAt + duration.value(7, 'd') + duration.value(5, 'm')))
      );
    }

    function isSelfUserCommsOrProfileActionAllowed(data, prev, changed) {
      return (
        // Action: Edit profile metadata & discovery fields
        (changed.hasOnly(['displayName', 'bio', 'age', 'sex', 'email', 'updatedAt']) &&
         isValidUserProfile(data) &&
         (!('email' in data) || data.email == null ||
          (('email' in prev) && data.email == prev.email) ||
          ((!('email' in prev) || prev.email == null) && hasVerifiedEmail() && data.email == request.auth.token.email.lower()))) ||
        // Action: Backfill unique referralCode once if unset on legacy profile
        (changed.hasOnly(['referralCode', 'updatedAt']) &&
         (!('referralCode' in prev) || prev.referralCode == null || prev.referralCode == '') &&
         isValidReferralCode(data.referralCode)) ||
        // Action: Buy phone tokens for mic-to-mic scheduled conversations
        (changed.hasOnly(['phoneTokenBalance', 'totalPhoneTokensPurchased', 'updatedAt']) &&
         data.phoneTokenBalance is int &&
         data.totalPhoneTokensPurchased is int &&
         data.phoneTokenBalance > prev.get('phoneTokenBalance', 0) &&
         data.phoneTokenBalance <= 1000000 &&
         (data.phoneTokenBalance - prev.get('phoneTokenBalance', 0)) <= 1000 &&
         (data.totalPhoneTokensPurchased - prev.get('totalPhoneTokensPurchased', 0)) == (data.phoneTokenBalance - prev.get('phoneTokenBalance', 0)) &&
         data.totalPhoneTokensPurchased <= 1000000) ||
        // Action: Spend phone tokens (multiple of 5) to schedule a mic-to-mic conversation
        (changed.hasOnly(['phoneTokenBalance', 'updatedAt']) &&
         data.phoneTokenBalance is int &&
         data.phoneTokenBalance >= 0 &&
         data.phoneTokenBalance < prev.get('phoneTokenBalance', 0) &&
         ((prev.get('phoneTokenBalance', 0) - data.phoneTokenBalance) % 5 == 0) &&
         (prev.get('phoneTokenBalance', 0) - data.phoneTokenBalance) <= 600) ||
        // Action: Claim atomic 100% phone token refund from a declined/cancelled mic session
        (changed.hasOnly(['phoneTokenBalance', 'lastRefundedSessionId', 'updatedAt']) &&
         data.lastRefundedSessionId is string &&
         isValidId(data.lastRefundedSessionId) &&
         exists(/databases/$(database)/documents/mic_sessions/$(data.lastRefundedSessionId)) &&
         get(/databases/$(database)/documents/mic_sessions/$(data.lastRefundedSessionId)).data.requesterId == request.auth.uid &&
         get(/databases/$(database)/documents/mic_sessions/$(data.lastRefundedSessionId)).data.escrowStatus == 'refund_pending' &&
         getAfter(/databases/$(database)/documents/mic_sessions/$(data.lastRefundedSessionId)).data.escrowStatus == 'refunded' &&
         data.phoneTokenBalance == prev.get('phoneTokenBalance', 0) + get(/databases/$(database)/documents/mic_sessions/$(data.lastRefundedSessionId)).data.totalTokensCost) ||
        // Action: Buy video tokens for 1:1 creator private chat video calls (100 tokens/min)
        (changed.hasOnly(['videoTokenBalance', 'totalVideoTokensPurchased', 'updatedAt']) &&
         data.videoTokenBalance is int &&
         data.totalVideoTokensPurchased is int &&
         data.videoTokenBalance > prev.get('videoTokenBalance', 0) &&
         data.videoTokenBalance <= 1000000 &&
         (data.videoTokenBalance - prev.get('videoTokenBalance', 0)) <= 5000 &&
         (data.totalVideoTokensPurchased - prev.get('totalVideoTokensPurchased', 0)) == (data.videoTokenBalance - prev.get('videoTokenBalance', 0)) &&
         data.totalVideoTokensPurchased <= 10000000) ||
        // Action: Spend video tokens (100 tokens/min) to request a private chat video session
        (changed.hasOnly(['videoTokenBalance', 'updatedAt']) &&
         data.videoTokenBalance is int &&
         data.videoTokenBalance >= 0 &&
         data.videoTokenBalance < prev.get('videoTokenBalance', 0) &&
         ((prev.get('videoTokenBalance', 0) - data.videoTokenBalance) % 100 == 0) &&
         (prev.get('videoTokenBalance', 0) - data.videoTokenBalance) <= 6000) ||
        // Action: Claim atomic 100% video token refund from a declined/cancelled video session
        (changed.hasOnly(['videoTokenBalance', 'lastRefundedVideoSessionId', 'updatedAt']) &&
         data.lastRefundedVideoSessionId is string &&
         isValidId(data.lastRefundedVideoSessionId) &&
         exists(/databases/$(database)/documents/video_sessions/$(data.lastRefundedVideoSessionId)) &&
         get(/databases/$(database)/documents/video_sessions/$(data.lastRefundedVideoSessionId)).data.requesterId == request.auth.uid &&
         get(/databases/$(database)/documents/video_sessions/$(data.lastRefundedVideoSessionId)).data.escrowStatus == 'refund_pending' &&
         getAfter(/databases/$(database)/documents/video_sessions/$(data.lastRefundedVideoSessionId)).data.escrowStatus == 'refunded' &&
         data.videoTokenBalance == prev.get('videoTokenBalance', 0) + get(/databases/$(database)/documents/video_sessions/$(data.lastRefundedVideoSessionId)).data.totalTokensCost) ||
        // Action: Support staff (6+ months / 180+ days tenure) claims weekly 100-token stipend
        (changed.hasOnly(['voteBalance', 'lastSupportPayClaimAt', 'totalSupportPayTokensEarned', 'updatedAt']) &&
         hasSixMonthSupportTenure() &&
         hasSupportWeeklyCooldownElapsed() &&
         data.voteBalance == prev.voteBalance + 100 &&
         data.voteBalance <= 1000000 &&
         data.totalVotesCast == prev.totalVotesCast &&
         data.totalVotesPurchased == prev.totalVotesPurchased &&
         data.totalSupportPayTokensEarned == prev.get('totalSupportPayTokensEarned', 0) + 100 &&
         data.lastSupportPayClaimAt is timestamp &&
         data.lastSupportPayClaimAt <= request.time &&
         data.lastSupportPayClaimAt >= request.time - duration.value(5, 'm'))
      );
    }

